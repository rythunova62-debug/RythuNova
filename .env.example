# Local dev default. Switch to a Neon Postgres URL (and provider = "postgresql"
# in prisma/schema.prisma) when ready to deploy.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign session tokens. Generate a real random value for production,
# e.g.: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Admin bootstrap ---
# Used only by `npm run seed` to create/update the first admin account.
# Change these before running the seed against a real database.
ADMIN_EMAIL="admin@rythunova.test"
ADMIN_PASSWORD="ChangeMe123!"

# --- SMTP (placeholder — wired but not used until Phase 2 OTP/reset emails) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="placeholder@example.com"
SMTP_PASS="placeholder"
SMTP_FROM="RythuNova <no-reply@rythunova.in>"

# --- File storage (Supabase Storage — private bucket) ---
# From your Supabase project: Settings -> API Keys (Project URL + secret key),
# and the bucket name you created under Storage.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="replace-with-your-supabase-secret-key"
SUPABASE_STORAGE_BUCKET="rythunova-uploads"
